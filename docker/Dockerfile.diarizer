FROM nvidia/cuda:12.1.1-cudnn8-runtime-ubuntu22.04 AS base-diarizer

ENV DEBIAN_FRONTEND=noninteractive \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1

RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    ffmpeg \
    git \
    libsndfile1 \
    pkg-config \
    python3.10 \
    python3.10-dev \
    python3-pip \
    sox \
    && rm -rf /var/lib/apt/lists/* \
    && update-alternatives --install /usr/bin/python python /usr/bin/python3.10 1 \
    && update-alternatives --install /usr/bin/python3 python3 /usr/bin/python3.10 1

RUN python -m pip install --upgrade pip setuptools wheel

ARG TORCH_INDEX_URL=https://download.pytorch.org/whl/cu121

RUN python -m pip install --index-url ${TORCH_INDEX_URL} --extra-index-url https://pypi.org/simple \
    torch==2.1.1+cu121 torchaudio==2.1.1+cu121 \
    && python -m pip install numpy soundfile

RUN git clone --recurse-submodules https://github.com/BUTSpeechFIT/DiariZen.git /opt/DiariZen \
    && cd /opt/DiariZen \
    && python -m pip install -r requirements.txt \
    && python -m pip install -e . \
    && if [ -d pyannote-audio ]; then python -m pip install -e ./pyannote-audio; fi \
    && python -m pip install "huggingface_hub[cli]>=0.25"

WORKDIR /workspace/project

CMD ["sleep", "infinity"]
