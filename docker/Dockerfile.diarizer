FROM nvidia/cuda:12.1.1-cudnn8-runtime-ubuntu22.04 AS base-diarizer

ENV DEBIAN_FRONTEND=noninteractive \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1

RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    ffmpeg \
    git \
    libsndfile1 \
    pkg-config \
    python3.10 \
    python3.10-dev \
    python3-pip \
    sox \
    && rm -rf /var/lib/apt/lists/* \
    && update-alternatives --install /usr/bin/python python /usr/bin/python3.10 1 \
    && update-alternatives --install /usr/bin/python3 python3 /usr/bin/python3.10 1

RUN python -m pip install --upgrade pip setuptools wheel

ARG TORCH_INDEX_URL=https://download.pytorch.org/whl/cu121

RUN python -m pip install --index-url ${TORCH_INDEX_URL} --extra-index-url https://pypi.org/simple \
    torch==2.1.1+cu121 torchaudio==2.1.1+cu121 \
    && python -m pip install numpy soundfile

RUN git clone --recurse-submodules https://github.com/BUTSpeechFIT/DiariZen.git /opt/DiariZen \
    && cd /opt/DiariZen \
    && python -m pip install -r requirements.txt \
    && python -m pip install -e . \
    && if [ -d pyannote-audio ]; then python -m pip install -e ./pyannote-audio; fi \
    && python -m pip install "huggingface_hub[cli]>=0.25"

# Visual 화자분리(얼굴 클러스터 + 능동 화자 탐지) 의존성
# onnxruntime 는 CUDA 12 전용 휠로 통일 (DiariZen 임베딩도 동일 모듈 사용)
# numpy 는 1.26.4 로 고정 — insightface 가 numpy 2.x 를 끌어오면 numpy 1.x 로 빌드된 torch/onnxruntime 가 깨진다
RUN python -m pip uninstall -y onnxruntime onnxruntime-gpu || true \
RUN python -m pip uninstall -y onnxruntime onnxruntime-gpu || true \
    && python -m pip install --index-url https://download.pytorch.org/whl/cu121 --extra-index-url https://pypi.org/simple torchvision==0.16.1 \
    && python -m pip install \
        "numpy==1.26.4" \
        insightface==0.7.3 \
        opencv-python-headless \
        python_speech_features \
        modelscope==1.20.0 \
        addict \
        "datasets<3" \
        oss2 \
        simplejson \
        yapf \
        scipy \
        scikit-learn \
        speechbrain==1.0.2 \
        hyperpyyaml \
        scenedetect \
        gdown \
        coloredlogs \
        flatbuffers \
        packaging \
        protobuf \
        sympy \
    && python -m pip uninstall -y onnxruntime onnxruntime-gpu || true \
    && python -m pip install --no-deps --index-url https://aiinfra.pkgs.visualstudio.com/PublicPackages/_packaging/onnxruntime-cuda-12/pypi/simple/ onnxruntime-gpu==1.18.0

RUN python -m pip install --no-deps \
        whisperx==3.3.1 \
        faster-whisper==1.1.0 \
        ctranslate2==4.4.0 \
        av==13.1.0 \
        transformers==4.51.3 \
        tokenizers==0.21.4 \
        nltk==3.9.1 \
    && python -m pip install \
        huggingface-hub==0.30.2 \
        regex==2024.11.6

WORKDIR /workspace/project

CMD ["sleep", "infinity"]
