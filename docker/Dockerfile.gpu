FROM nvidia/cuda:12.4.1-cudnn-runtime-ubuntu22.04 AS base-gpu

ENV DEBIAN_FRONTEND=noninteractive \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1

RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    ffmpeg \
    git \
    libavcodec-dev \
    libavdevice-dev \
    libavfilter-dev \
    libavformat-dev \
    libavutil-dev \
    libsndfile1 \
    libswresample-dev \
    libswscale-dev \
    pkg-config \
    python3 \
    python3-dev \
    python3-pip \
    python-is-python3 \
    sox \
    && rm -rf /var/lib/apt/lists/*

RUN python -m pip install --upgrade pip setuptools wheel

ARG TORCH_INDEX_URL=https://download.pytorch.org/whl/cu124

RUN python -m pip install --index-url ${TORCH_INDEX_URL} --extra-index-url https://pypi.org/simple \
    torch==2.5.1+cu124 torchvision==0.20.1+cu124 torchaudio==2.5.1+cu124 \
    && python -m pip install numpy soundfile


FROM base-gpu AS separator

RUN python -m pip install "audio-separator[gpu]>=0.28.0" "silero-vad>=6.2.1"

WORKDIR /workspace/project

CMD ["sleep", "infinity"]


FROM base-gpu AS speaker

RUN python -m pip install "qwen-asr>=0.0.6" modelscope==1.20.0 "funasr>=1.1.16" \
    && python -m pip uninstall -y torchvision

WORKDIR /workspace/project

CMD ["sleep", "infinity"]
