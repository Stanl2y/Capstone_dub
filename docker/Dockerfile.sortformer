# NVIDIA Sortformer(end-to-end 화자분리) 격리 이미지 — NeMo 2.x + torch 2.4(cu124). RTX 3080(sm_86) 지원.
FROM nvidia/cuda:12.4.1-cudnn-runtime-ubuntu22.04 AS base-sortformer

ENV DEBIAN_FRONTEND=noninteractive \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1

RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    ffmpeg \
    git \
    libsndfile1 \
    pkg-config \
    python3.10 \
    python3.10-dev \
    python3-pip \
    sox \
    && rm -rf /var/lib/apt/lists/* \
    && update-alternatives --install /usr/bin/python python /usr/bin/python3.10 1 \
    && update-alternatives --install /usr/bin/python3 python3 /usr/bin/python3.10 1

RUN python -m pip install --upgrade pip setuptools wheel

# NeMo 2.x = torch 2.4+ 필요. Sortformer(diar_sortformer_4spk)는 NeMo 2.0+ 에 포함.
ARG TORCH_INDEX_URL=https://download.pytorch.org/whl/cu124
RUN python -m pip install --index-url ${TORCH_INDEX_URL} --extra-index-url https://pypi.org/simple \
    torch==2.4.1+cu124 torchaudio==2.4.1+cu124

# NeMo[asr] 이 datasets 를 옛 버전으로 backtrack → pyarrow<4(py3.10 컴파일 불가 고대 numpy 소스빌드)
# 로 추락하는 문제. NeMo 2.0 동시대 modern 휠로 선핀해 차단(NeMo 1.23 때와 동일 회피).
RUN python -m pip install "numpy==1.26.4" "Cython<3.0" packaging setuptools wheel \
    && python -m pip install \
        "huggingface_hub==0.24.6" \
        "transformers==4.43.0" \
        "datasets==2.19.0" \
        "pyarrow==15.0.2" \
        "fsspec==2024.3.1" \
    && python -m pip install "nemo_toolkit[asr]==2.0.0"

# HTTP 데몬/추론 런타임.
RUN python -m pip install "fastapi==0.111.0" "uvicorn==0.30.1" "pydantic>=2.7" requests soundfile

WORKDIR /workspace/project
# Sortformer 가중치(nvidia/diar_sortformer_4spk-v1)는 최초 from_pretrained 시 자동 다운로드.
CMD ["sleep", "infinity"]
