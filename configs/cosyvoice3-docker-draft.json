{
  "input_video": "input/input.mp4",
  "paths": {
    "raw_audio": "audio/{input_stem}/raw.wav",
    "dialogue_audio": "audio/{input_stem}/dialogue.wav",
    "bgm_audio": "audio/{input_stem}/bgm.wav",
    "diarization_rttm": "meta/{input_stem}/diarization.rttm",
    "diarization_json": "meta/{input_stem}/diarization.json",
    "diarization_stabilized_json": "meta/{input_stem}/diarization_stabilized.json",
    "speaker_chunks_json": "meta/{input_stem}/speaker_chunks.json",
    "emotion_json": "meta/{input_stem}/emotion.json",
    "asr_json": "meta/{input_stem}/asr.json",
    "translated_json": "meta/{input_stem}/translated.json",
    "master_timeline_json": "meta/{input_stem}/master_timeline_{tts_engine}.json",
    "tts_validation_json": "meta/{input_stem}/tts_validation_{tts_engine}.json",
    "chunks_dir": "chunks/{input_stem}",
    "dub_dir": "dub/{input_stem}_{tts_engine}",
    "final_dub_audio": "output/{input_stem}/final_dub_{tts_engine}.wav",
    "output_video": "output/{input_stem}/output_{tts_engine}.mp4"
  },
  "audio": {
    "sample_rate": 16000,
    "channels": 1,
    "source_sample_rate": 44100,
    "source_channels": 2,
    "chunk_source": "audio/{input_stem}/dialogue.wav",
    "final_sample_rate": 44100,
    "final_channels": 2,
    "background_gain": 0.8,
    "dub_gain": 1.0,
    "target_peak_dbfs": -1.0,
    "final_codec": "aac",
    "final_bitrate": "192k",
    "subtractive_ensemble": {
      "models": [
        "model_bs_roformer_ep_317_sdr_12.9755.ckpt",
        "MDX23C-8KFFT-InstVoc_HQ.ckpt"
      ],
      "weights": [
        0.5,
        0.5
      ],
      "model_dir": "models/separation"
    }
  },
  "models": {
    "emotion": "models/emotion/emotion2vec-large",
    "asr": "models/asr/Qwen3-ASR-1.7B",
    "tts": "models/tts/Fun-CosyVoice3-0.5B",
    "cosyvoice_repo": "third_party/CosyVoice",
    "diarization": "models/diarization/diarizen-wavlm-large-s80-md-v2",
    "diarization_embedding": "models/embedding/wespeaker-voxblink2-samresnet100"
  },
  "runtime": {
    "device": "cuda:0",
    "dtype": "float16"
  },
  "chunking": {
    "speaker_merge_gap_sec": 1,
    "min_chunk_sec": 0.5,
    "max_chunk_sec": 15
  },
  "diarization": {
    "min_speakers": 1,
    "max_speakers": 7,
    "seg_duration": 8,
    "stabilization": {
      "enabled": true,
      "same_speaker_gap_sec": 0.1,
      "bridge_max_sec": 0.5,
      "bridge_gap_sec": 0.6,
      "tiny_segment_sec": 0.12,
      "absorb_gap_sec": 0.25,
      "max_passes": 5
    }
  },
  "emotion": {
    "backend": "funasr",
    "skip_existing": true
  },
  "translation": {
    "mode": "vectorengine_gpt",
    "source_language": "English",
    "target_language": "Korean",
    "env_file": ".env",
    "timeout_sec": 120,
    "context_refine": true,
    "context_batch_size": 12,
    "duration_control": true,
    "max_budget_rewrites": 2
  },
  "tts": {
    "system_prompt": "",
    "stream": false,
    "skip_existing": true,
    "min_prompt_sec": 3.0,
    "passthrough_on_copy_source": true,
    "fit_to_duration": true,
    "duration_fit_min_tempo": 0.8,
    "duration_fit_max_tempo": 1.25,
    "duration_fit_trim_overlong": false,
    "trim_silence": true,
    "silence_trim_threshold_dbfs": -45.0,
    "max_leading_silence_sec": 0.1,
    "max_trailing_silence_sec": 0.2,
    "cap_risky_self_reference": true,
    "prompt_cap_max_sec": 4.5,
    "engine": "cosyvoice",
    "speed": 1.0,
    "style_priority": "balanced",
    "reference_mode": "auto",
    "compact_timeline": true,
    "instruction": {
      "enabled": true,
      "mode": "vectorengine_gpt",
      "env_file": ".env",
      "timeout_sec": 20,
      "batch_size": 6,
      "skip_existing": true,
      "fallback_on_error": true
    },
    "validation": {
      "enabled": false,
      "language": "Korean",
      "mark_stale_on_fail": true,
      "fail_on_error": false
    }
  },
  "pipeline": {
    "stop_on_error": true,
    "use_separator": true,
    "redirect_nonspeech": true
  },
  "redirect_nonspeech": {
    "model_path": "models/vad/silero_vad.jit",
    "threshold": 0.3,
    "min_speech_ms": 500,
    "pad_ms": 100,
    "ramp_ms": 15
  }
}
