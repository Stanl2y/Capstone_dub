{
  "input_video": "input/input.mp4",
  "paths": {
    "raw_audio": "audio/{input_stem}/raw.wav",
    "dialogue_audio": "audio/{input_stem}/dialogue.wav",
    "bgm_audio": "audio/{input_stem}/bgm.wav",
    "diarization_rttm": "meta/{input_stem}/diarization.rttm",
    "diarization_json": "meta/{input_stem}/diarization.json",
    "diarization_stabilized_json": "meta/{input_stem}/diarization_stabilized.json",
    "diarization_refiner_report": "meta/{input_stem}/diarization_team_refiner_report.json",
    "asd_tracks_json": "meta/{input_stem}/asd_tracks.json",
    "chunk_embeddings_json": "meta/{input_stem}/chunk_embeddings.json",
    "chunk_overrides_json": "meta/{input_stem}/chunk_overrides.json",
    "speaker_chunks_json": "meta/{input_stem}/speaker_chunks.json",
    "emotion_json": "meta/{input_stem}/emotion.json",
    "asr_json": "meta/{input_stem}/asr.json",
    "translated_json": "meta/{input_stem}/translated.json",
    "master_timeline_json": "meta/{input_stem}/master_timeline_{tts_engine}.json",
    "tts_validation_json": "meta/{input_stem}/tts_validation_{tts_engine}.json",
    "chunks_dir": "chunks/{input_stem}",
    "dub_dir": "dub/{input_stem}_{tts_engine}",
    "final_dub_audio": "output/{input_stem}/final_dub_{tts_engine}.wav",
    "output_video": "output/{input_stem}/output_{tts_engine}.mp4"
  },
  "audio": {
    "sample_rate": 16000,
    "channels": 1,
    "source_sample_rate": 44100,
    "source_channels": 2,
    "chunk_source": "audio/{input_stem}/dialogue.wav",
    "final_sample_rate": 44100,
    "final_channels": 2,
    "background_gain": 0.8,
    "dub_gain": 1.0,
    "target_peak_dbfs": -1.0,
    "final_codec": "aac",
    "final_bitrate": "192k",
    "subtractive_ensemble": {
      "models": [
        "model_bs_roformer_ep_317_sdr_12.9755.ckpt",
        "MDX23C-8KFFT-InstVoc_HQ.ckpt"
      ],
      "weights": [
        0.5,
        0.5
      ],
      "model_dir": "models/separation"
    }
  },
  "models": {
    "emotion": "models/emotion/emotion2vec-large",
    "asr": "models/asr/Qwen3-ASR-1.7B",
    "tts": "models/tts/Fun-CosyVoice3-0.5B",
    "cosyvoice_repo": "third_party/CosyVoice",
    "diarization": "models/diarization/diarizen-wavlm-large-s80-md-v2",
    "diarization_embedding": "models/embedding/wespeaker-voxblink2-samresnet100"
  },
  "runtime": {
    "device": "cuda:0",
    "dtype": "float16"
  },
  "chunking": {
    "speaker_merge_gap_sec": 0.7,
    "min_chunk_sec": 0.2,
    "max_chunk_sec": 10,
    "merge_f0_gate_hz": 50.0,
    "remerge_f0_gate_hz": 0.0,
    "short_absorb_sec": 0.35,
    "remerge_after_reassign": true
  },
  "diarization": {
    "engine": "team_refiner",
    "fusion_url": "http://fusion:8918",
    "min_duration": 0.3,
    "min_speakers": 1,
    "max_speakers": 7,
    "seg_duration": 8,
    "team_refiner": {
      "fallback_to_base_on_error": true,
      "run_whisperx": true,
      "language": "en",
      "whisperx_model": "large-v3",
      "whisperx_download_dir": "models/whisperx",
      "torch_cache_dir": "models/torch",
      "whisperx_batch_size": 1,
      "eres2netv2": {
        "enabled": true,
        "required": false,
        "cache_dir": "models/modelscope"
      },
      "time_gap_split": {
        "enabled": true,
        "gap_sec": 5.0,
        "voice_diff_threshold": 0.15,
        "min_target_sim": 0.5
      },
      "intra_spk_split": {
        "enabled": true,
        "min_sim": 0.5,
        "passes": 3
      },
      "sandwich_override": {
        "enabled": true,
        "gap_sec": 0.3
      },
      "word_level_intra_split": {
        "enabled": true,
        "margin": 0.1
      },
      "ecapa": {
        "enabled": false,
        "model_path": "models/embedding/spkrec-ecapa-voxceleb",
        "cosine_thr": 0.5,
        "min_sub": 2,
        "min_dominant": 3,
        "max_main_speakers": 3,
        "device": "cuda",
        "required": false
      },
      "gap_fill_bg": {
        "enabled": false,
        "gap_min": 1.5,
        "pad": 0.2,
        "sim_main_match": 0.5,
        "bg_merge": 0.4,
        "overlap_max": 0.5,
        "required": false
      }
    },
    "stabilization": {
      "enabled": true,
      "same_speaker_gap_sec": 0.1,
      "bridge_max_sec": 0.5,
      "bridge_gap_sec": 0.6,
      "tiny_segment_sec": 0.12,
      "absorb_gap_sec": 0.25,
      "max_passes": 5
    },
    "reassign": {
      "enabled": true,
      "min_sim": 0.4,
      "margin": 0.07,
      "passes": 3,
      "model": "models/embedding/wespeaker-voxblink2-samresnet100/speaker-embedding.onnx",
      "split": {
        "enabled": true,
        "within_margin": 0.08,
        "min_sub": 2,
        "sil_min": 0.15,
        "min_label_chunks": 4,
        "f0_split_hz": 70.0
      },
      "merge": {
        "enabled": true,
        "margin": 0.05,
        "min_threshold": 0.6,
        "min_members": 2
      },
      "singleton_absorb": {
        "enabled": true,
        "dur_low": 0.6,
        "dur_high": 1.4,
        "tau_abs": 0.5,
        "tau_strong": 0.62,
        "margin": 0.06,
        "gap_sec": 0.5,
        "proximity_floor": 0.3
      },
      "recluster": {
        "enabled": true,
        "tau": 0.45,
        "max_chunks": 18
      }
    }
  },
  "emotion": {
    "backend": "funasr",
    "skip_existing": true,
    "text_fusion": {
      "enabled": true,
      "mode": "vectorengine_gpt",
      "batch_size": 8,
      "text_weight": 0.7,
      "timeout_sec": 30,
      "skip_existing": true
    }
  },
  "asr": {
    "language": "English",
    "full_audio": {
      "enabled": true,
      "forced_aligner": "models/aligner/Qwen3-ForcedAligner-0.6B",
      "max_new_tokens": 4096,
      "gap_recovery": {
        "enabled": false,
        "gap_min": 0.6,
        "pad": 0.3,
        "vol": 3.0,
        "silence_dbfs": -55.0,
        "max_word_dur": 2.0,
        "min_word_dur": 0.06
      }
    },
    "gate": {
      "min_rms_dbfs": null,
      "min_voiced_ratio": 0.35
    }
  },
  "translation": {
    "mode": "vectorengine_gpt",
    "source_language": "English",
    "target_language": "Korean",
    "env_file": ".env",
    "timeout_sec": 240,
    "context_refine": true,
    "context_batch_size": 12,
    "duration_control": true,
    "max_budget_rewrites": 2,
    "register_plan": false
  },
  "tts": {
    "system_prompt": "",
    "stream": false,
    "skip_existing": true,
    "min_prompt_sec": 3.0,
    "passthrough_on_copy_source": true,
    "fit_to_duration": true,
    "duration_fit_min_tempo": 0.8,
    "duration_fit_max_tempo": 1.25,
    "duration_fit_trim_overlong": false,
    "trim_silence": true,
    "silence_trim_threshold_dbfs": -45.0,
    "max_leading_silence_sec": 0.1,
    "max_trailing_silence_sec": 0.2,
    "cap_risky_self_reference": true,
    "prompt_cap_max_sec": 4.5,
    "engine": "cosyvoice",
    "speed": 1.0,
    "use_rl_llm": true,
    "style_priority": "balanced",
    "reference_mode": "auto",
    "compact_timeline": true,
    "instruction": {
      "enabled": true,
      "mode": "vectorengine_gpt",
      "env_file": ".env",
      "timeout_sec": 20,
      "batch_size": 6,
      "skip_existing": true,
      "fallback_on_error": true
    },
    "validation": {
      "enabled": false,
      "language": "Korean",
      "mark_stale_on_fail": true,
      "fail_on_error": false
    }
  },
  "pipeline": {
    "stop_on_error": true,
    "use_separator": true,
    "redirect_nonspeech": true,
    "visual_diarize": {
      "enabled": true,
      "run_lightasd": true,
      "python": "python",
      "det_size": 640,
      "face_sim_threshold": 0.4,
      "min_speak_score": 0.5,
      "min_evidence": 5.0,
      "dominant_ratio": 0.5,
      "min_split_chunks": 2,
      "do_split": true,
      "do_reassign": true,
      "do_intra_split": true,
      "min_intra_sec": 0.7
    }
  },
  "redirect_nonspeech": {
    "model_path": "models/vad/silero_vad.jit",
    "threshold": 0.4,
    "min_speech_ms": 500,
    "pad_ms": 100,
    "ramp_ms": 15
  }
}